{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",

    // `DOM` is for client components (React, Web Bluetooth, `document`);
    // `.cloudflare/types/index.d.ts` declares the Worker runtime globals for
    // server components and route handlers. `skipLibCheck` keeps the two
    // declaration sets from fighting over `Request`/`Response`.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // `vinext/types` loads the ambient declarations for `next/server`,
    // `next/headers` and friends — vinext ships those shims instead of the
    // `next` package, so `import ... from "next/headers"` type-checks.
    "types": ["vinext/types"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,

    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,

    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "app/**/*",
    "src/**/*.ts",
    "cloudflare.config.ts",
    "vite.config.ts",
    ".cloudflare/types/index.d.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
